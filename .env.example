# ------------------------------------------------------------
# 복사해서 .env 로 사용하세요:  cp .env.example .env
# 실제 비밀값은 절대 커밋하지 않습니다. (.env 는 .gitignore 대상)
# ------------------------------------------------------------

# 공통
NODE_ENV=development
LOG_LEVEL=debug

# API 서버
API_PORT=4000
# 쉼표로 구분. 개발 시 Vite dev 서버 주소
CORS_ORIGINS=http://localhost:5173

# MySQL (docker compose 가 아래 값으로 컨테이너를 초기화합니다)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=game_admin
MYSQL_USER=game_admin
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only

# Redis (REDIS_PORT 는 docker compose 가 PC 쪽에 여는 포트. 바꾸면 REDIS_URL 도 같이 변경)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ga:dev:

# ---------------- 인증 ----------------
# 필수. 최소 32자 랜덤 문자열 — 비어 있으면 API 서버가 시작되지 않습니다.
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# 선택 (기본값)
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_DAYS=7
# REFRESH_REUSE_GRACE_SEC=10
# COOKIE_SECURE=false            # 미지정 시 production 에서만 true
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2

# 로그인 시도 IP당 분당 허용 횟수
# LOGIN_RATE_LIMIT_PER_MIN=10
# 통계(대시보드) 날짜 기준 시간대, 분 단위 (KST = 540)
# STAT_TZ_OFFSET_MINUTES=540

# ---------------- 시뮬레이터 (개발 전용) ----------------
# ⚠️ 게임 서버 대신 이벤트를 넣는 내부 API 키. 비우면 내부 API 비활성. production 에서는 항상 비활성.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=

# ---------------- 업로드 ----------------
# 업로드 이미지 저장 폴더 (API 실행 위치 기준, .gitignore 에 포함). 배포 때 S3 로 교체 예정
ASSET_STORAGE_DIR=storage/uploads

# ---------------- 시드 ----------------
# npm run db:seed 가 만드는 운영자 4명(super/operator/cs/viewer@example.com)의 공통 초기 비밀번호
# 10자 이상, 영문·숫자 포함
SEED_ADMIN_PASSWORD=

# ---------------- MCP 서버 (apps/mcp) ----------------
# MCP 서버는 DB·Redis 정보를 쓰지 않고 API 만 호출합니다. 원격(HTTP)은 요청의 Bearer API 토큰을 그대로 사용
# GAME_ADMIN_API_URL=http://localhost:4000
# MCP_HOST=127.0.0.1
# MCP_PORT=4100
# 허용 Host 헤더 (DNS rebinding 방지) — 운영은 실제 도메인
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# 브라우저 Origin 허용 목록 (비우면 Origin 헤더가 붙은 요청은 거부)
# MCP_ALLOWED_ORIGINS=
# 로컬 stdio 실행(npm run dev:mcp:stdio) 전용 — 웹 백오피스 → API 토큰에서 발급. 커밋 금지
# GAME_ADMIN_API_TOKEN=
