# 운영 서버 /opt/game-admin/.env — 이 파일을 복사해 값을 채운다. 저장소에 올리지 않는다.
# 비밀값 생성: openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48

# ---------------- 도메인 ----------------
# DuckDNS 등에서 받은 주소 (예: game-admin-demo.duckdns.org)
DOMAIN=

# ---------------- MySQL (컨테이너는 처음 만들 때만 이 값을 사용) ----------------
MYSQL_DATABASE=game_admin
MYSQL_USER=game_admin
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---------------- 인증 ----------------
JWT_ACCESS_SECRET=
# 운영에서는 기본값 true (HTTPS 전용 쿠키)
# COOKIE_SECURE=true
# LOGIN_RATE_LIMIT_PER_MIN=10

# ---------------- 시드 (첫 배포 때만, 끝나면 지워도 됨) ----------------
# 운영자 4명 공통 초기 비밀번호 — 첫 로그인 후 각자 변경
SEED_ADMIN_PASSWORD=

# 시뮬레이터 내부 API 는 production 에서 항상 꺼짐 → INTERNAL_API_KEY 는 두지 않는다
LOG_LEVEL=info

# ---------------- 체험 모드 (포트폴리오 공개 서버) — docs/demo-mode.md ----------------
# 로그인 화면에 체험 계정을 공개하고 매일 04:00(KST) 데이터를 초기화한다. 실제 운영이면 둘 다 false
DEMO_MODE=true
DEMO_ACCOUNT_EMAIL=demo@example.com
DEMO_ACCOUNT_PASSWORD=
DEMO_DAILY_RESET=true
# 5분마다 가상 회원 활동 (대시보드 '오늘' 이 움직이게, 0 = 끔)
DEMO_ACTIVITY_USERS=30

# ---------------- 이메일 (docs/email.md) — 비우면 전부 가상 발송 ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_REAL_ALLOWLIST=
EMAIL_DAILY_REAL_LIMIT=250
DEMO_EMAIL_DAILY_LIMIT=50
DEMO_EMAIL_PER_IP_HOUR=3

# AI 어시스턴트 — Anthropic 콘솔에서 사용 한도(월 지출 상한)도 함께 설정할 것
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_DAILY_LIMIT=500
ASSISTANT_PER_ADMIN_HOUR=30
DEMO_ASSISTANT_DAILY_LIMIT=100
DEMO_ASSISTANT_PER_IP_DAY=10
