{
  "name": "game-admin",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,worker -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:api": "npm run dev -w @game-admin/api",
    "dev:web": "npm run dev -w @game-admin/web",
    "dev:worker": "npm run dev:worker -w @game-admin/api",
    "dev:mcp": "npm run dev -w @game-admin/mcp",
    "dev:mcp:stdio": "npm run dev:stdio -w @game-admin/mcp",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @game-admin/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w @game-admin/api",
    "db:migrate": "npm run db:migrate -w @game-admin/api",
    "db:seed": "npm run db:seed -w @game-admin/api",
    "db:seed:game": "npm run db:seed:game -w @game-admin/api --",
    "infra:up": "docker compose up -d mysql redis",
    "infra:down": "docker compose down",
    "simulate": "npm run simulate -w @game-admin/api --",
    "coverage": "npm run coverage -w @game-admin/api && npm run coverage -w @game-admin/mcp"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-import-x": "^4.6.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
